# Sliplane env vars — copy values from ~/forge-ops/keys/sliplane-hermes-researcher
# DO NOT commit a filled .env to git. Sliplane uses dashboard-encrypted env, not files.

# OpenRouter API key (sk-or-v1-...)
OPENROUTER_API_KEY=

# Fine-grained GitHub PAT scoped to notaprompt/hermes-agent with contents:write
GITHUB_TOKEN=

# ntfy.sh topic for push notifications (pick something hard to guess)
NTFY_TOPIC=

# Hermes user id (default 10000)
HERMES_UID=10000
HERMES_GID=10000
