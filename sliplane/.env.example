# Sliplane env vars — copy values from ~/forge-ops/keys/sliplane-hermes-researcher
# DO NOT commit a filled .env to git. Sliplane uses dashboard-encrypted env, not files.

# OpenRouter API key (sk-or-v1-...)
OPENROUTER_API_KEY=

# Fine-grained GitHub PAT scoped to notaprompt/hermes-agent with contents:write
GITHUB_TOKEN=

# Google Chat integration (replaces ntfy for v1)
# Get these from GCP Console + Workspace Admin setup — see sliplane/README.md
GOOGLE_CHAT_PROJECT_ID=
GOOGLE_CHAT_SUBSCRIPTION_NAME=projects/<project-id>/subscriptions/hermes-chat-subscription
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=/opt/data/secrets/gchat-sa.json
GOOGLE_CHAT_ALLOWED_USERS=
GOOGLE_CHAT_HOME_CHANNEL_NAME=Reframed Ops

# Hermes user id (default 10000)
HERMES_UID=10000
HERMES_GID=10000
